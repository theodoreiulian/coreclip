# API Keys
GEMINI_API_KEY=

# App Settings
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://redis:6379/0

# TikTok posting via local browser automation (Playwright driving the real
# TikTok Studio web uploader with a logged-in session). No API, no dev app.
# TIKTOK_HEADLESS=false to watch the automation in a visible window.
TIKTOK_SESSION_DIR=./output/.tiktok_sessions
TIKTOK_HEADLESS=true
TIKTOK_SCHEDULE_HORIZON_DAYS=10
TIKTOK_MIN_SCHEDULE_LEAD_MIN=20

# Paths
# Leave INTERMEDIATE_DIR unset to use the platform temp volume (%TEMP% on
# Windows, /tmp or $TMPDIR on macOS). Only set it explicitly to move scratch
# space to another disk, and use a path valid for your OS.
OUTPUT_DIR=./output
LOGS_DIR=./logs
# INTERMEDIATE_DIR=

# Logging
LOG_LEVEL=INFO

# FFmpeg tuning
FFMPEG_INTERMEDIATE_PRESET=veryfast
FFMPEG_INTERMEDIATE_CRF=23
FFMPEG_FINAL_PRESET=medium
FFMPEG_FINAL_CRF=20
FFMPEG_THREADS=0
FFMPEG_PREFERRED_ENCODER=

# Whisper tuning
WHISPER_CPU_THREADS=4
WHISPER_BATCH_SIZE=4
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=true

# Reframer
REFRAMER_MODE=auto
REFRAMER_RENDER=ffmpeg

# Captioning
BURN_CAPTIONS=true

# Download quality limits
YTDLP_MAX_HEIGHT=720
YTDLP_MAX_AUDIO_BITRATE=128

# Cleanup Configuration
CLEANUP_SOURCE_AFTER_CLIPPING=true
CLEANUP_INTERMEDIATES=true
CLEANUP_TRANSCRIPTS=true
